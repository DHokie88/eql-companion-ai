/** Expanded rankings, fair target scenarios, level planning and readable client effects. */
import assert from 'node:assert/strict'
import type { Page } from 'playwright-core'
import { buildIfStale, dumpArtifacts, settle, waitHydrated } from './appHarness.mjs'
import { mainWindow } from './appWindow.mjs'
import { launchOnFixture, stageFixture } from './logFixture.mjs'
import { stageAnalysisSources } from './spellAnalysisFixture.mjs'

async function choose(page: Page, id: string, name: string): Promise<void> {
  await page.getByTestId(id).click()
  await page.getByRole('option', { name, exact: true }).click()
}
async function rankings(page: Page): Promise<void> {
  await page.getByTestId('spells-tab-rankings').click()
  await settle(() => page.getByTestId('rankings-record').count(), (n) => n === 40)
  const efficiency = page.getByTestId('spells-sort-efficiency')
  assert.equal(await efficiency.locator('..').getAttribute('aria-sort'), 'descending')
  const first = await page.getByTestId('rankings-record').first().getAttribute('data-spell-id')
  assert.equal(first, '145', 'the most efficient spell comes from the end of the full source catalog')
  await page.getByRole('button', { name: 'Go to page 2', exact: true }).click()
  await settle(() => page.getByTestId('rankings-record').count(), (n) => n === 9)
  const id = await page.getByTestId('rankings-record').first().getAttribute('data-spell-id')
  await page.getByTestId(`spells-open-${id}`).click()
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('rankings-record').first().getAttribute('data-spell-id'), id)
  await choose(page, 'rankings-columns', 'Cast (s)')
  await page.keyboard.press('Escape')
  await page.getByTestId('spells-sort-cast').click()
  await page.getByRole('button', { name: /^Largest cast:/ }).click()
  await settle(() => page.getByTestId('rankings-record').first().getAttribute('data-spell-id'), (value) => value === '501')
  assert.match(await page.getByTestId('rankings-record').innerText(), /Zero mana/)
  await page.getByRole('tab', { name: /^Unsupported/ }).click()
  await settle(() => page.getByTestId('rankings-record').count(), (n) => n === 1)
  await page.getByTestId('rankings-record').getByRole('button', { name: 'Explain', exact: true }).click()
  await page.getByText('How this was calculated', { exact: true }).click()
  assert.match(await page.getByTestId('spells-rankings').innerText(), /Unsupported effect formula: 999/)
}
async function areaAndCompare(page: Page): Promise<void> {
  await page.getByTestId('rankings-tab-aoe').click()
  await page.getByRole('tab', { name: /^Ranked \(/ }).click()
  await settle(() => page.getByTestId('rankings-record').count(), (n) => n === 2)
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '100')
  assert.equal(await page.getByTestId('spells-amount-302-damage').innerText(), '80', 'rain uses the four-hit cast budget')
  await choose(page, 'spells-target-count', '2 targets')
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '50')
  await choose(page, 'spells-target-count', 'Spell maximum')
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '150')
  await choose(page, 'spells-target-count', '4 targets')
  await page.getByTestId('rankings-compare-301').click(); await page.getByTestId('rankings-compare-302').click()
  await page.getByTestId('spells-open-301').click()
  const detail = page.getByTestId('spells-detail')
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '100')
  assert.match(await detail.innerText(), /aggregate pack total/)
  await detail.getByTestId('spells-mode-emulate').click()
  await settle(() => page.evaluate(() => window.eq.spellLibrary.modifierContext()), (context) => context.preferences.mode === 'emulate')
  await detail.getByTestId('spells-modifiers-panel').locator('.MuiAccordionSummary-root').first().click()
  await detail.getByTestId('spells-rank-301').click()
  await page.getByRole('option', { name: 'V', exact: true }).click()
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text.includes('100 → 128'))
  await detail.getByTestId('spells-mode-client').click()
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '100')
  await page.getByTestId('spells-detail-back').click()
  await page.getByTestId('spells-tab-compare').click()
  await page.getByRole('button', { name: 'Aggregate pack total', exact: true }).click()
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '100')
  await choose(page, 'compare-reference', 'Lava Storm (302)')
  assert.match(await page.getByTestId('spells-calculation').first().innerText(), /\+20 \(\+25%\) vs reference/)
  await page.getByTestId('spells-calculation').first().getByText('How this was calculated', { exact: true }).click()
  assert.match(await page.getByTestId('spells-compare').innerText(), /Cycle = cast 2.5s \+ max/)
}
async function levelsAndEffects(page: Page): Promise<void> {
  await page.getByTestId('spells-tab-by-level').click()
  await settle(() => page.getByTestId('by-level-record').count(), (n) => n === 2)
  await page.getByRole('tab', { name: 'Upcoming', exact: true }).click()
  await page.getByTestId('by-level-preview-401').waitFor()
  await page.getByTestId('by-level-search').fill('401')
  await settle(() => page.getByTestId('by-level-record').count(), (n) => n === 1)
  await page.getByTestId('by-level-preview-401').click()
  await page.getByTestId('spell-effect-summary').waitFor()
  assert.match(await page.getByTestId('spell-effect-summary').innerText(), /caster level 51/)
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('by-level-search').inputValue(), '401')
  assert.equal(await page.getByTestId('spells-level').inputValue(), '50', 'preview does not replace the workspace caster level')
  await page.getByTestId('spells-tab-browse').click()
  await page.getByTestId('spells-search').fill('738')
  await page.getByTestId('spells-open-738').click()
  const summary = page.getByTestId('spell-effect-summary')
  await settle(() => summary.innerText(), (text) => text.includes('Slows attacks'))
  assert.match(await summary.innerText(), /Slows movement by 80%/)
  assert.match(await summary.innerText(), /Slows attacks by 30%/)
  assert.match(await summary.innerText(), /12 seconds.*single.*magic/s)
  assert.match(await summary.innerText(), /Casting range 150 game units/)
  await page.getByTestId('spells-technical-details').getByRole('button').click()
  assert.match(await page.getByRole('table', { name: 'Decoded client effects' }).innerText(), /Movement speed.*SPA 3/s)
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('spells-search').inputValue(), '738')
  assert.equal((await page.evaluate(() => window.eq.spellLibrary.history())).snapshots.length, 1)
}

buildIfStale()
const staged = stageFixture('e2e-combat.log'), count = stageAnalysisSources(staged)
const launch = await launchOnFixture(staged)
const page = await mainWindow(launch.app)
page.setDefaultTimeout(20_000)
try {
  await waitHydrated(page)
  await settle(() => page.evaluate(() => window.eq.spellLibrary.status()), (s) => s.dataset?.recordCount === count, { timeoutMs: 30_000 })
  await page.getByTestId('nav-spells').click()
  await choose(page, 'spells-scope', 'All spells, including internal records')
  await page.getByTestId('spells-level').fill('50')
  await rankings(page); console.log('Rankings pagination, highlights, groups and sorting passed.')
  await areaAndCompare(page); console.log('AOE scenarios and reference comparisons passed.')
  await levelsAndEffects(page)
  await dumpArtifacts(page, 'spell-analysis-ready')
  console.log('Spells expansion: full-catalog pagination/sorting, highlights/groups, AOE/rain budgets, detail parity, reference differences, level previews/Back, English effects and unchanged history passed.')
} catch (error) { await dumpArtifacts(page, 'spell-analysis-failure'); throw error }
finally { await launch.close(); await staged.dispose() }
