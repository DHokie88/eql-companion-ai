/** Expanded rankings, fair target scenarios, level planning and readable client effects. */
import assert from 'node:assert/strict'
import type { Page } from 'playwright-core'
import { buildIfStale, dumpArtifacts, settle, waitHydrated } from './appHarness.mjs'
import { mainWindow } from './appWindow.mjs'
import { launchOnFixture, stageFixture } from './logFixture.mjs'
import { stageAnalysisSources } from './spellAnalysisFixture.mjs'
import { browseRainChecks, categoryAndTableChecks } from './spellRainBrowseSteps.mjs'

async function choose(page: Page, id: string, name: string): Promise<void> {
  await page.getByTestId(id).click()
  await page.getByRole('option', { name, exact: true }).click()
}
async function rankings(page: Page): Promise<void> {
  await page.getByTestId('spells-tab-browse').click()
  await page.getByTestId('spells-reset-filters').click()
  await choose(page, 'spells-target-count', '1 target')
  await page.getByTestId('spells-type-dd').click()
  await page.getByTestId('spells-group-ranked').click()
  const efficiency = page.getByTestId('spells-sort-efficiency')
  const efficiencySort = (): Promise<string | null> => efficiency.locator('..').getAttribute('aria-sort')
  if (await efficiencySort() !== 'descending') {
    await efficiency.click()
    if (await efficiencySort() !== 'descending') await efficiency.click()
  }
  assert.equal(await settle(async () => ({ count: await page.getByTestId('spells-record').count(),
    id: await page.getByTestId('spells-record').first().locator('td').first().innerText(), loading: await page.getByLabel('Searching spells').count() }),
    (value) => value.count === 40 && value.id === '402' && value.loading === 0).then((value) => value.id), '402')
  assert.equal(await efficiency.locator('..').getAttribute('aria-sort'), 'descending')
  const first = await page.getByTestId('spells-record').first().locator('td').first().innerText()
  assert.equal(first, '402', 'uniform mana, so the level-60 120-damage row beats the level-12 84-damage row at rank I')
  await page.getByRole('button', { name: 'Go to page 2', exact: true }).click()
  await settle(() => page.getByTestId('spells-record').count(), (n) => n === 9)
  const id = await page.getByTestId('spells-record').first().locator('td').first().innerText()
  await page.getByTestId(`spells-open-${id}`).click()
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('spells-record').first().locator('td').first().innerText(), id)
  await choose(page, 'spells-columns', 'Cast (s)')
  await page.keyboard.press('Escape')
  await page.getByTestId('spells-sort-cast').click()
  await page.getByTestId('spells-sort-amount').click()
  await page.getByTestId('spells-sort-amount').click()
  await settle(() => page.getByTestId('spells-record').first().locator('td').first().innerText(), (value) => value === '501')
  assert.match(await page.getByTestId('spells-group-zero-mana').innerText(), /Zero mana \(1\)/i)
  await page.getByTestId('spells-group-excluded').click()
  await settle(() => page.getByTestId('spells-record').count(), (n) => n === 1)
  await page.getByTestId('spells-open-502').click()
  const detail = page.getByTestId('spells-detail')
  await detail.getByText('How this was calculated', { exact: true }).click()
  assert.match(await detail.innerText(), /Unsupported effect formula: 999/)
  await page.getByTestId('spells-detail-back').click()
}
async function areaAndCompare(page: Page): Promise<void> {
  await page.getByTestId('spells-type-aoe').click()
  await page.getByTestId('spells-group-ranked').click()
  await choose(page, 'spells-target-count', '4 targets')
  await settle(() => page.getByTestId('spells-record').count(), (n) => n === 2)
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '104')
  assert.equal(await page.getByTestId('spells-amount-302-damage').innerText(), '84', 'rain uses the four-hit cast budget')
  await choose(page, 'spells-target-count', '2 targets')
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '52')
  await choose(page, 'spells-target-count', '8 targets')
  assert.equal(await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '208'), '208')
  await choose(page, 'spells-target-count', '4 targets')
  await page.getByTestId('spells-compare-301').click(); await page.getByTestId('spells-compare-302').click()
  await page.getByTestId('spells-open-301').click()
  const detail = page.getByTestId('spells-detail')
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text === '104')
  assert.match(await detail.innerText(), /aggregate pack total/)
  const slider = detail.getByRole('slider', { name: 'Spell rank' })
  await slider.focus()
  await page.keyboard.press('Home')
  for (let step = 0; step < 4; step++) await page.keyboard.press('ArrowRight')
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text.includes('100 → 128'))
  await slider.focus()
  await page.keyboard.press('Home')
  await settle(() => detail.getByTestId('spells-amount-301-damage').innerText(), (text) => text.includes('100 → 104'))
  await page.getByTestId('spells-detail-back').click()
  await page.getByTestId('spells-tab-compare').click()
  await choose(page, 'spells-target-count', '2 targets')
  await page.getByRole('button', { name: 'One-target full cast', exact: true }).click()
  const rain = page.getByTestId('rain-summary-302')
  assert.equal(await settle(() => rain.innerText(), (text) => text === '21 × 2'), '21 × 2')
  assert.match(await page.getByTestId('spells-calculation').filter({ has: rain }).innerText(), /Rain · 3 waves max · 4 hits max/)
  await page.getByRole('button', { name: 'Aggregate pack total', exact: true }).click()
  assert.equal(await settle(() => rain.innerText(), (text) => text === '21 × 4'), '21 × 4')
  await choose(page, 'spells-target-count', '4 targets')
  await settle(() => page.getByTestId('spells-amount-301-damage').innerText(), (text) => text.includes('104'))
  await choose(page, 'compare-reference', 'Lava Storm (302)')
  assert.match(await page.getByTestId('spells-calculation').first().innerText(), /\+20 \(\+23\.81%\) vs reference/)
  await page.getByTestId('spells-calculation').first().getByText('How this was calculated', { exact: true }).click()
  assert.match(await page.getByTestId('spells-compare').innerText(), /Cycle = cast 2.45s \+ max/)
}
async function levelsAndEffects(page: Page): Promise<void> {
  await page.getByTestId('spells-tab-by-level').click()
  await settle(() => page.getByTestId('by-level-record').count(), (n) => n === 2)
  const minimum = page.getByTestId('spells-min-level')
  assert.equal(await minimum.inputValue(), '50')
  await minimum.fill('51')
  await minimum.press('Enter')
  await page.getByRole('tab', { name: 'At level 51', exact: true }).waitFor()
  await settle(() => page.getByTestId('by-level-record').count(), (n) => n === 1)
  assert.equal(await page.getByTestId('by-level-record').first().getAttribute('data-spell-id'), '401')
  await page.getByRole('tab', { name: 'Upcoming', exact: true }).click()
  assert.equal(await page.getByLabel('Through level', { exact: true }).count(), 0)
  const maximum = page.getByTestId('spells-max-level')
  await maximum.fill('60')
  await maximum.press('Enter')
  const ids = page.getByTestId('by-level-record')
  await settle(() => ids.evaluateAll((rows) => rows.map((row) => row.getAttribute('data-spell-id')).join(',')), (value) => value === '401,402')
  await page.getByTestId('spells-columns').click()
  await page.getByTestId('spells-column-spa').click()
  await page.getByTestId('spells-column-cast').click()
  await page.keyboard.press('Escape')
  assert.match(await page.getByTestId('spell-spa-401').innerText(), /SPA 79/)
  assert.equal(await page.getByTestId('spells-sort-cast').count(), 1)
  await page.getByRole('button', { name: 'Use character level', exact: true }).click()
  assert.equal(await minimum.inputValue(), '50')
  await page.getByTestId('by-level-preview-401').waitFor()
  await page.getByTestId('spells-search').fill('401')
  await settle(() => page.getByTestId('by-level-record').count(), (n) => n === 1)
  await page.getByTestId('by-level-preview-401').click()
  await page.getByTestId('spell-effect-summary').waitFor()
  assert.match(await page.getByTestId('spell-effect-summary').innerText(), /caster level 51/)
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('spells-search').inputValue(), '401')
  const maxAfterPreview = await page.getByTestId('spells-max-level').inputValue()
  assert.match(maxAfterPreview, /^\d+$/)
  await page.getByTestId('spells-tab-browse').click()
  await page.getByTestId('spells-reset-filters').click()
  await page.getByTestId('spells-group-all').click()
  await page.getByTestId('spells-search').fill('738')
  await page.getByTestId('spells-open-738').click()
  const summary = page.getByTestId('spell-effect-summary')
  await settle(() => summary.innerText(), (text) => text.includes('Slows attacks'))
  assert.match(await summary.innerText(), /Slows movement by 80%/)
  assert.match(await summary.innerText(), /Slows attacks by 30%/)
  assert.match(await summary.innerText(), /12 seconds.*single.*magic/s)
  assert.match(await summary.innerText(), /Casting range 150 game units/)
  await page.getByTestId('spells-technical-details').getByRole('button').click()
  assert.match(await page.getByRole('table', { name: 'Decoded client effects' }).innerText(), /Movement speed.*SPA 3/s)
  await page.getByTestId('spells-detail-back').click()
  assert.equal(await page.getByTestId('spells-search').inputValue(), '738')
  assert.equal((await page.evaluate(() => window.eq.spellLibrary.history())).snapshots.length, 1)
}

buildIfStale()
const staged = stageFixture('e2e-combat.log'), count = stageAnalysisSources(staged)
const launch = await launchOnFixture(staged)
const page = await mainWindow(launch.app)
page.setDefaultTimeout(20_000)
try {
  await waitHydrated(page)
  const notice = page.getByTestId('telemetry-notice-off')
  if (await notice.isVisible()) await notice.click()
  await settle(() => page.evaluate(() => window.eq.spellLibrary.status()), (s) => s.dataset?.recordCount === count, { timeoutMs: 30_000 })
  await page.getByTestId('nav-spells').click()
  await page.getByTestId('spells-classes').click(); await page.getByTestId('spells-classes-all').click()
  await browseRainChecks(page)
  await categoryAndTableChecks(page)
  await rankings(page); console.log('Rankings pagination, highlights, groups and sorting passed.')
  await areaAndCompare(page); console.log('AOE scenarios and reference comparisons passed.')
  await levelsAndEffects(page)
  await dumpArtifacts(page, 'spell-analysis-ready')
  console.log('Spells expansion: full-catalog pagination/sorting, highlights/groups, AOE/rain budgets, detail parity, reference differences, level previews/Back, English effects and unchanged history passed.')
} catch (error) { await dumpArtifacts(page, 'spell-analysis-failure'); throw error }
finally { await launch.close(); await staged.dispose() }
