/** Package the approved EQ Oracle crest using Electron's image decoder (no extra dependencies). */
import { spawnSync } from 'node:child_process'
import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmdirSync, unlinkSync, writeFileSync } from 'node:fs'
import { createRequire } from 'node:module'
import { tmpdir } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..')
const source = join(root, 'build', 'icon-source.png')
const build = join(root, 'build')
const sizes = [256, 128, 64, 48, 32, 24, 16]
const work = mkdtempSync(join(tmpdir(), 'eq-oracle-icon-'))

// NativeImage is available only inside Electron, not the Node process running tsx.
// The helper creates no BrowserWindow and exits without touching any app profile.
const helper = String.raw`
const { app, nativeImage } = require('electron')
const { writeFileSync } = require('node:fs')
const { join } = require('node:path')
try {
  const source = nativeImage.createFromPath(process.argv[2])
  if (source.isEmpty()) throw new Error('Cannot decode the approved Oracle icon')
  for (const size of [256, 128, 64, 48, 32, 24, 16]) {
    const frame = source.resize({ width: size, height: size, quality: 'best' })
    writeFileSync(join(process.argv[3], String(size) + '.png'), frame.toPNG())
  }
  app.exit(0)
} catch (error) {
  console.error(error)
  app.exit(1)
}
`

try {
  const entry = join(work, 'render.cjs')
  writeFileSync(entry, helper)
  const env = { ...process.env }
  delete env.ELECTRON_RUN_AS_NODE
  const electron = createRequire(import.meta.url)('electron') as string
  const result = spawnSync(electron, [entry, source, work], {
    env, stdio: 'inherit', windowsHide: true, timeout: 30_000
  })
  if (result.error) throw result.error
  if (result.status !== 0) throw new Error(`Icon renderer exited with ${String(result.status)}`)

  const frames = sizes.map((size) => ({ size, png: readFileSync(join(work, `${size}.png`)) }))
  const header = Buffer.alloc(6)
  header.writeUInt16LE(1, 2)
  header.writeUInt16LE(frames.length, 4)
  let offset = 6 + frames.length * 16
  const directory = frames.map(({ size, png }) => {
    const entry = Buffer.alloc(16)
    entry[0] = entry[1] = size === 256 ? 0 : size
    entry.writeUInt16LE(1, 4)
    entry.writeUInt16LE(32, 6)
    entry.writeUInt32LE(png.length, 8)
    entry.writeUInt32LE(offset, 12)
    offset += png.length
    return entry
  })
  const master = frames[0].png
  const tray = frames.find((f) => f.size === 32)
  if (!tray) throw new Error('The tray icon frame is missing')
  writeFileSync(join(build, 'icon.png'), master)
  writeFileSync(join(build, 'icon-tray.png'), tray.png)
  writeFileSync(join(build, 'icon.ico'), Buffer.concat([header, ...directory, ...frames.map((f) => f.png)]))
  writeFileSync(join(root, 'site', 'assets', 'icon.png'), master)
  writeFileSync(join(root, 'share-server', 'src', 'logo.ts'),
    '// Generated by npm run gen:icon from build/icon-source.png.\n' +
    `const LOGO_BASE64 = '${master.toString('base64')}'\n\n` +
    'let cached: Uint8Array<ArrayBuffer> | null = null\n\n' +
    'export function logoPng(): Uint8Array<ArrayBuffer> {\n' +
    '  if (cached) return cached\n' +
    '  const bin = atob(LOGO_BASE64)\n' +
    '  const out = new Uint8Array(bin.length)\n' +
    '  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i)\n' +
    '  cached = out\n' +
    '  return out\n' +
    '}\n')

  const preview = process.env.EQ_ICON_PREVIEW
  if (preview) {
    mkdirSync(preview, { recursive: true })
    for (const { size, png } of frames) writeFileSync(join(preview, `icon-preview-${size}.png`), png)
  }
  console.log(`EQ Oracle crest: app, tray, ICO (${sizes.join('/')}), site and share logo generated.`)
} finally {
  for (const name of readdirSync(work)) unlinkSync(join(work, name))
  rmdirSync(work)
}
